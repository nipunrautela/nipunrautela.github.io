---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProseLayout from "../../layouts/ProseLayout.astro";
import { isPublished, readingTime, sortByDate } from "../../lib/utils";

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", isPublished);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const all = sortByDate(await getCollection("blog", isPublished));
const index = all.findIndex((p) => p.id === post.id);
const previous = all[index + 1];
const next = all[index - 1];
---

<ProseLayout
  title={data.title}
  description={data.description}
  date={data.pubDate}
  updatedDate={data.updatedDate}
  tags={data.tags}
  linkTags
  cover={data.cover}
  coverAlt={data.coverAlt}
  readingTime={readingTime(post.body)}
  backLink={{ href: "/blog/", label: "All writing" }}
>
  <Content />

  <Fragment slot="footer">
    {
      (previous || next) && (
        <nav
          class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-2"
          aria-label="More posts"
        >
          {previous ? (
            <a
              href={`/blog/${previous.id}/`}
              class="group rounded-xl border border-border p-4 transition-colors hover:border-border-strong"
            >
              <p class="font-mono text-xs text-fg-subtle">Previous</p>
              <p class="mt-1 font-medium transition-colors group-hover:text-accent">
                {previous.data.title}
              </p>
            </a>
          ) : (
            <div />
          )}

          {next && (
            <a
              href={`/blog/${next.id}/`}
              class="group rounded-xl border border-border p-4 text-right transition-colors hover:border-border-strong sm:col-start-2"
            >
              <p class="font-mono text-xs text-fg-subtle">Next</p>
              <p class="mt-1 font-medium transition-colors group-hover:text-accent">
                {next.data.title}
              </p>
            </a>
          )}
        </nav>
      )
    }
  </Fragment>
</ProseLayout>
