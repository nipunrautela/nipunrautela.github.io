---
import type { CollectionEntry } from "astro:content";
import Tag from "../ui/Tag.astro";

interface Props {
  groups: CollectionEntry<"skills">[];
}

const { groups } = Astro.props;
---

<dl class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
  {
    groups.map(({ data }) => (
      <div>
        <dt class="mb-3 font-mono text-xs tracking-[0.15em] text-fg-subtle uppercase">
          {data.category}
        </dt>
        <dd>
          <ul class="flex flex-wrap gap-1.5">
            {data.items.map((item) => (
              <li>
                <Tag size="md">{item}</Tag>
              </li>
            ))}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>
