---
import type { CollectionEntry } from "astro:content";

interface Props {
  stats: CollectionEntry<"stats">[];
}

const { stats } = Astro.props;

/**
 * The final value is rendered server-side, so the figures are correct with no
 * JavaScript. The count-up below is enhancement only.
 */
---

<dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    stats.map(({ data }, index) => (
      <div
        class="spotlight-card rounded-2xl border border-border bg-surface/60 p-6 backdrop-blur-sm transition-colors hover:border-border-strong"
        data-spotlight
        data-reveal
        data-reveal-delay={index * 80}
      >
        <dt class="sr-only">{data.label}</dt>
        <dd>
          <p class="flex items-baseline gap-0.5 text-4xl font-semibold tracking-tight sm:text-5xl">
            <span class="text-gradient tabular-nums" data-count-to={data.value}>
              {data.value}
            </span>
            <span class="text-2xl text-accent sm:text-3xl">{data.suffix}</span>
          </p>

          <p class="mt-3 text-sm font-medium">{data.label}</p>
          <p class="mt-1 text-xs leading-relaxed text-fg-subtle">
            {data.detail}
          </p>
        </dd>
      </div>
    ))
  }
</dl>

<script>
  // Counts up once, when the number first scrolls into view. The markup already
  // holds the final value, so this is pure enhancement.
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const counters = document.querySelectorAll<HTMLElement>("[data-count-to]");

  if (!reducedMotion && counters.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;

          const element = entry.target as HTMLElement;
          const to = Number(element.dataset.countTo ?? 0);
          observer.unobserve(element);

          const duration = 1100;
          const started = performance.now();

          const tick = (now: number) => {
            const progress = Math.min((now - started) / duration, 1);
            // Ease-out cubic: fast start, settles onto the final value.
            const eased = 1 - Math.pow(1 - progress, 3);

            element.textContent = String(Math.round(to * eased));

            if (progress < 1) requestAnimationFrame(tick);
          };

          element.textContent = "0";
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );

    for (const counter of counters) observer.observe(counter);
  }
</script>
