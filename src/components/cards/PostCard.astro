---
import type { CollectionEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { formatDate } from "../../lib/utils";

interface Props {
  post: CollectionEntry<"blog">;
  readingTime?: string;
}

const { post, readingTime } = Astro.props;
const { data } = post;
const href = `/blog/${post.id}/`;
---

<article
  class="group relative border-b border-border py-6 transition-colors first:pt-0 hover:border-border-strong"
>
  <div
    class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-fg-subtle"
  >
    <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
    {readingTime && <span aria-hidden="true">·</span>}
    {readingTime && <span>{readingTime}</span>}
    {data.draft && <span class="text-accent">Draft</span>}
  </div>

  <h3 class="text-lg font-semibold transition-colors group-hover:text-accent">
    <a href={href} class="after:absolute after:inset-0">{data.title}</a>
  </h3>

  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-fg-muted">
    {data.description}
  </p>

  <div class="mt-3 flex items-center gap-4">
    {
      data.tags.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <li class="font-mono text-[11px] text-fg-subtle">#{tag}</li>
          ))}
        </ul>
      )
    }
    <span
      class="ml-auto inline-flex items-center gap-1 text-sm font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100"
      aria-hidden="true"
    >
      Read
      <Icon name="arrow-right" size={14} />
    </span>
  </div>
</article>
