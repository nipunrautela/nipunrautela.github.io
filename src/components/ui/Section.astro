---
import Icon from "./Icon.astro";

/**
 * A titled page section with an optional "see all" affordance on the right.
 * Keeps vertical rhythm consistent and stages each section as its own beat:
 * the header reveals first, the content follows.
 */
interface Props {
  title: string;
  /** Small uppercase kicker above the title. */
  eyebrow?: string;
  /** Two-digit index, e.g. "01". Rendered as a monospace marker. */
  number?: string;
  description?: string;
  /** Renders a trailing link in the section header. */
  link?: { href: string; label: string };
  id?: string;
  class?: string;
}

const {
  title,
  eyebrow,
  number,
  description,
  link,
  id,
  class: className = "",
} = Astro.props;
---

<section id={id} class={`py-16 sm:py-24 ${className}`}>
  <div
    class="mb-10 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 sm:mb-12"
    data-reveal
  >
    <div class="max-w-xl">
      {
        (number || eyebrow) && (
          <p class="mb-3 flex items-center gap-3 font-mono text-xs tracking-[0.18em] text-fg-subtle uppercase">
            {number && <span class="text-accent">{number}</span>}
            {number && eyebrow && (
              <span class="h-px w-8 bg-border-strong" aria-hidden="true" />
            )}
            {eyebrow && <span>{eyebrow}</span>}
          </p>
        )
      }
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
      {description && <p class="mt-4 text-fg-muted">{description}</p>}
    </div>

    {
      link && (
        <a
          href={link.href}
          class="group inline-flex items-center gap-1.5 text-sm font-medium text-fg-muted transition-colors hover:text-accent"
        >
          {link.label}
          <Icon
            name="arrow-right"
            size={15}
            class="transition-transform duration-200 group-hover:translate-x-0.5"
          />
        </a>
      )
    }
  </div>

  <div data-reveal data-reveal-delay="90">
    <slot />
  </div>
</section>
