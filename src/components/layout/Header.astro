---
import { SITE, NAV } from "../../site.config";
import { isActivePath } from "../../lib/utils";
import Icon from "../ui/Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import ScrollProgress from "../visuals/ScrollProgress.astro";

const current = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-bg/70 backdrop-blur-xl"
  style="view-transition-name: site-header;"
>
  <div
    class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-5 sm:px-8"
  >
    <a
      href="/"
      class="font-mono text-sm font-medium tracking-tight transition-colors hover:text-accent"
    >
      {SITE.title}<span class="text-accent">.</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 sm:flex">
      {
        NAV.map((item) => {
          const active = isActivePath(current, item.href);
          return (
            <a
              href={item.href}
              data-nav-anchor={item.href.includes("#") ? "" : undefined}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-full px-3.5 py-1.5 text-sm transition-colors hover:text-fg",
                active
                  ? "bg-surface-2 font-medium text-fg"
                  : "text-fg-muted",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full border border-border text-fg-muted transition-colors hover:text-fg sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span id="nav-icon-open" class="flex"><Icon name="menu" size={16} /></span>
        <span id="nav-icon-close" class="hidden"
          ><Icon name="close" size={16} /></span
        >
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="hidden border-t border-border bg-bg px-5 py-3 sm:hidden"
  >
    <ul class="flex flex-col">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActivePath(current, item.href) ? "page" : undefined}
              class:list={[
                "block py-2.5 text-sm transition-colors",
                isActivePath(current, item.href)
                  ? "font-medium text-accent"
                  : "text-fg-muted hover:text-fg",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ScrollProgress />
</header>

<script>
  // --- Mobile menu ---
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  const setMenu = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    iconOpen?.classList.toggle("flex", !open);
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("flex", open);
    iconClose?.classList.toggle("hidden", !open);
  };

  toggle?.addEventListener("click", () =>
    setMenu(menu?.classList.contains("hidden") ?? false),
  );

  // Close after tapping an anchor, or the target scrolls in behind the menu.
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });

  // --- Scroll spy ---
  // The portfolio is one page, so nav state follows the section in view rather
  // than the route. Only runs where those sections exist.
  const anchorLinks = document.querySelectorAll<HTMLAnchorElement>(
    'a[data-nav-anchor][href*="#"]',
  );

  if (anchorLinks.length > 0) {
    const byId = new Map<string, HTMLAnchorElement[]>();

    for (const link of anchorLinks) {
      const id = link.href.split("#")[1];
      const section = id && document.getElementById(id);
      if (!section) continue;
      byId.set(id, [...(byId.get(id) ?? []), link]);
    }

    const setActive = (id: string | null) => {
      for (const [sectionId, links] of byId) {
        const active = sectionId === id;
        for (const link of links) {
          link.classList.toggle("bg-surface-2", active);
          link.classList.toggle("font-medium", active);
          link.classList.toggle("text-fg", active);
          link.classList.toggle("text-fg-muted", !active);
          if (active) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
      }
    };

    // Track which sections intersect, then highlight the topmost one.
    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }

        // Two sections can straddle the band during a scroll; the lower one is
        // the one the reader has arrived at.
        const ordered = [...byId.keys()].filter((id) => visible.has(id));
        setActive(ordered[ordered.length - 1] ?? null);
      },
      // Discount the sticky header, and require a section to reach the upper
      // half of the viewport before it takes over.
      { rootMargin: "-72px 0px -55% 0px", threshold: 0 },
    );

    for (const id of byId.keys()) {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    }
  }
</script>
